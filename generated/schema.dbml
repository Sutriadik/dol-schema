// Open ADE — Delivery Ops Layer: skema companion NocoDB
// Dibangkitkan dari dol_schema/model.py (versi companion-2026.10.4).
// JANGAN diedit tangan: ubah model.py lalu jalankan `python -m dol_schema --emit`.
// Buka di dbdiagram.io (tempel isi berkas ini) atau ekstensi DBML di VS Code.

Project dol_schema {
  database_type: 'PostgreSQL'
  Note: 'Warna header = pemilik tabel: biru = AI Engineer, ungu = Network Engineer, hijau = RPA Engineer, oranye = PM, abu-abu = hanya PostgreSQL (tidak dikirim ke NocoDB), kuning = usulan yang ditunda. Kolom bertanda [DIISI PM] hanya diubah PM. Kolom *_ref MyBhakti sengaja BUKAN foreign key (briefing hlm. 7).'
}

Table document [headercolor: #3498DB] {
  id bigint [pk, increment]
  content_hash text [not null, unique, note: 'Sidik Berkas. sha256 isi berkas -- kunci anti-dobel; berkas yang sama diproses ulang memperbarui baris yang sama']
  doc_type document_doc_type [not null, note: 'Jenis Dokumen']
  source_filename text [not null, note: 'Nama Berkas']
  page_count integer [note: 'Jumlah Halaman; CHECK (page_count > 0)']
  markdown text [note: 'Isi Dokumen. teks hasil pembacaan sistem, agar PM bisa membaca tanpa membuka PDF. Bagian yang rusak OCR bisa sudah dipoles mesin: PDF asli tetap acuan']
  validation_notes text [note: 'Catatan Validasi. peringatan tingkat dokumen, mis. salinan ganda atau jumlah item tidak sama dengan total']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'Dokumen. Setiap berkas yang masuk, apa pun jenisnya. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null, unique, note: 'ID Dokumen. satu kontrak = satu dokumen']
  mybhakti_project_ref text [note: 'Rujukan Proyek MyBhakti. proyek/deal di MyBhakti, diisi n8n -- pengikat semua dokumen satu proyek; sengaja bukan relasi (hlm. 7)']
  contract_type contract_contract_type [note: 'Jenis Kontrak. bentuk dokumen dasar']
  contract_number text [note: 'Nomor Kontrak. nomor resmi kontrak / SPK / PKS']
  contract_number_internal text [note: 'Nomor Registrasi Internal. nomor registrasi internal BUT']
  work_title text [note: 'Nama Pekerjaan. judul pengadaan / lingkup pekerjaan']
  location_text text [note: 'Lokasi. kota/lokasi seperti tertulis di kontrak (tempat dibuat atau pelaksanaan)']
  contract_date_text text [note: 'Tanggal Kontrak Tertulis. apa adanya di dokumen']
  contract_date date [note: 'Tanggal Kontrak. hasil baca; kosong bila ragu']
  start_date_text text [note: 'Tanggal Mulai Tertulis']
  start_date date [note: 'Tanggal Mulai']
  end_date_text text [note: 'Tanggal Selesai Tertulis']
  end_date date [note: 'Tanggal Selesai']
  duration_text text [note: 'Jangka Waktu. mis. \'30 hari kalender\'']
  contract_value numeric(18,2) [note: 'Nilai Kontrak. total termasuk PPN bila dokumen menyebutnya begitu; CHECK (contract_value >= 0)']
  subtotal_value numeric(18,2) [note: 'Subtotal; CHECK (subtotal_value >= 0)']
  vat_value numeric(18,2) [note: 'Nilai PPN; CHECK (vat_value >= 0)']
  vat_percentage text [note: 'Persentase PPN. apa adanya di dokumen']
  currency char(3) [not null, default: 'IDR', note: 'Mata Uang']
  payment_mechanism text [note: 'Cara Pembayaran']
  penalty_terms text [note: 'Ketentuan Denda']
  bast_terms text [note: 'Syarat Lampiran BAST. ringkasan; rincian per syarat ada di tabel Syarat Kontrak']
  bank_name text [note: 'Nama Bank']
  bank_account_number text [note: 'Nomor Rekening']
  bank_account_name text [note: 'Nama Pemilik Rekening']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'Kontrak. Kontrak/SPK pelanggan dalam bentuk apa pun -- dibaca sekali, dipakai sepanjang proyek (hlm. 11). Sumber kebenaran BAST pelanggan. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_party [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null, note: 'ID Kontrak']
  role contract_party_role [not null, note: 'Peran. pemberi_kerja = pelanggan; pelaksana = BUT. Ditentukan dari nama instansi, bukan dari sebutan \'Pihak Pertama/Kedua\'']
  party_label_text text [note: 'Sebutan di Dokumen. mis. \'PIHAK PERTAMA\' -- sebutan ini bisa terbalik antar-format kontrak, karena itu disimpan terpisah dari peran']
  org_name_text text [not null, note: 'Nama Instansi']
  signer_name text [note: 'Nama Penandatangan. kosong bila tidak terbaca']
  signer_title text [note: 'Jabatan Penandatangan']
  org_address_text text [note: 'Alamat']
  mybhakti_party_ref text [note: 'Rujukan Pihak MyBhakti. diisi n8n']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (contract_id, role) [unique]
  }

  Note: 'Pihak Kontrak. Pihak penandatangan kontrak seperti tertulis saat diteken -- bukan data master. Satu orang bisa muncul di banyak baris karena menandatangani banyak dokumen. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_item [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null, note: 'ID Kontrak']
  line_no integer [not null, note: 'No Urut. urutan baca di dokumen; CHECK (line_no > 0)']
  category text [note: 'Kelompok']
  description text [not null, note: 'Uraian']
  specification text [note: 'Spesifikasi']
  quantity numeric(18,2) [note: 'Volume; CHECK (quantity >= 0)']
  unit text [note: 'Satuan']
  period text [note: 'Periode']
  unit_price numeric(18,2) [note: 'Harga Satuan. selalu dikonfirmasi PM (hlm. 20); CHECK (unit_price >= 0)']
  line_total numeric(18,2) [note: 'Jumlah Harga; CHECK (line_total >= 0)']
  charge_type contract_item_charge_type [note: 'Jenis Biaya. dari judul kolom tabel tempat harganya tertulis, bukan tebakan. mrc = Harga Satuan adalah harga PER BULAN, jadi Jumlah Harga biasanya harga x volume x periode. Kosong bila tabel tidak menyebut OTC/MRC atau judulnya tidak jelas']
  remarks text [note: 'Keterangan']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (contract_id, line_no) [unique]
  }

  Note: 'Rincian Kontrak. BoQ kontrak = kewajiban ke pelanggan (hlm. 7). Sumber tunggal rincian pekerjaan untuk BAST pelanggan. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_requirement [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null, note: 'ID Kontrak']
  line_no integer [not null, note: 'No Urut; CHECK (line_no > 0)']
  requirement_type contract_requirement_requirement_type [not null, note: 'Jenis Syarat. lampiran wajib / syarat serah terima / boleh parsial']
  requirement_text text [not null, note: 'Isi Syarat. mis. \'Berita Acara Uji Terima\'']
  clause_ref text [note: 'Pasal Rujukan. mis. \'Pasal 9 ayat 2\'']
  evidence_page integer [note: 'Halaman. halaman tempat syarat ini ditemukan']
  evidence_quote text [note: 'Kutipan Dokumen. kutipan pendek agar PM tidak perlu membaca ulang kontrak (hlm. 11)']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (contract_id, line_no) [unique]
  }

  Note: 'Syarat Kontrak. Aturan dari kontrak, bukan angka: lampiran wajib, syarat serah terima, boleh parsial (hlm. 11). Baris lampiran wajib adalah separuh checklist gabungan BAST. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_payment_term [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null, note: 'ID Kontrak']
  line_no integer [not null, note: 'No Urut. urutan di daftar Ketentuan Pembayaran dokumen; CHECK (line_no > 0)']
  term_text text [not null, note: 'Isi Ketentuan. kalimat apa adanya']
  term_label_text text [note: 'Termin. sebutan termin seperti tertulis (\'Termin I\', \'Uang Muka\', \'Pelunasan\'); kosong bila baris ini bukan satu termin tertentu']
  amount numeric(18,2) [note: 'Nilai Termin. hanya bila baris menyebut satu termin dengan tepat satu nominal Rp. Tidak pernah dihitung dari persentase atau dibagi dari total; CHECK (amount >= 0)']
  percentage_text text [note: 'Persentase. apa adanya, mis. \'30%\'']
  evidence_page integer [note: 'Halaman. halaman tempat ketentuan ini ditemukan']
  evidence_quote text [note: 'Kutipan Dokumen']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (contract_id, line_no) [unique]
  }

  Note: 'Ketentuan Pembayaran. Termin dan syarat pembayaran kontrak. BAST sering per termin (WORKSHOP_SKEMA: kontrak -> BAST 1:N), jadi termin perlu ada sebelum skema BAST disepakati. Baris tanpa Termin adalah syarat pembayaran umum (lampiran tagihan, rekening, back to back). Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table sph [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null, unique, note: 'ID Dokumen']
  mybhakti_project_ref text [note: 'Rujukan Proyek MyBhakti. diisi n8n']
  mybhakti_vendor_ref text [note: 'Rujukan Vendor MyBhakti. diisi n8n']
  sph_number text [note: 'Nomor SPH']
  sph_date_text text [note: 'Tanggal SPH Tertulis']
  sph_date date [note: 'Tanggal SPH']
  project_name text [note: 'Perihal. perihal / nama pekerjaan yang ditawarkan']
  client_name text [note: 'Ditujukan Kepada. instansi yang dituju surat']
  vendor_name text [note: 'Nama Vendor. penerbit SPH seperti tertulis']
  subtotal_value numeric(18,2) [note: 'Subtotal; CHECK (subtotal_value >= 0)']
  vat_percentage text [note: 'Persentase PPN. apa adanya di dokumen']
  vat_value numeric(18,2) [note: 'Nilai PPN; CHECK (vat_value >= 0)']
  total_price numeric(18,2) [note: 'Total Penawaran. grand total; CHECK (total_price >= 0)']
  validity_text text [note: 'Masa Berlaku. masa berlaku penawaran']
  payment_mechanism text [note: 'Cara Pembayaran']
  currency char(3) [not null, default: 'IDR', note: 'Mata Uang']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'SPH Vendor. Surat penawaran harga dari vendor (rantai hulu) -- lahir dari kebutuhan kontrak. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table sph_item [headercolor: #3498DB] {
  id bigint [pk, increment]
  sph_id integer [not null, note: 'ID SPH']
  line_no integer [not null, note: 'No Urut. urutan baca, bukan kolom \'No\' di dokumen; CHECK (line_no > 0)']
  category text [note: 'Kelompok']
  description text [not null, note: 'Uraian']
  specification text [note: 'Spesifikasi']
  brand text [note: 'Merek']
  part_number text [note: 'Nomor Part']
  quantity numeric(18,2) [note: 'Volume; CHECK (quantity >= 0)']
  unit text [note: 'Satuan']
  period text [note: 'Periode']
  unit_price numeric(18,2) [note: 'Harga Satuan. selalu dikonfirmasi PM (hlm. 20); CHECK (unit_price >= 0)']
  line_total numeric(18,2) [note: 'Jumlah Harga; CHECK (line_total >= 0)']
  charge_type sph_item_charge_type [note: 'Jenis Biaya. dari judul kolom tabel tempat harganya tertulis, bukan tebakan. mrc = Harga Satuan adalah harga PER BULAN, jadi Jumlah Harga biasanya harga x volume x periode. Kosong bila tabel tidak menyebut OTC/MRC atau judulnya tidak jelas']
  remarks text [note: 'Keterangan']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (sph_id, line_no) [unique]
  }

  Note: 'Rincian SPH. Baris penawaran vendor. Relasi ke barang yang dibeli (procurement item) untuk tabel banding harga dirancang di Bulan 5 -- belum ada di sini. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table bast [headercolor: #F1C40F] {
  id bigint [pk, increment]
  document_id integer [not null, unique, note: 'ID Dokumen']
  direction bast_direction [not null, note: 'Arah. customer = kita->pelanggan (acuan: kontrak); vendor = vendor->kita (acuan: PO) -- hlm. 10']
  contract_id integer [note: 'ID Kontrak. hanya untuk BAST pelanggan']
  mybhakti_po_ref text [note: 'Rujukan PO MyBhakti. diisi n8n; bukan relasi']
  bast_number_customer text [note: 'Nomor BAST Pelanggan']
  bast_number_internal text [note: 'Nomor BAST Internal. dari numbering service milik RPA (hlm. 20)']
  handover_date_text text [note: 'Tanggal Serah Terima Tertulis']
  handover_date date [note: 'Tanggal Serah Terima']
  handover_city text [note: 'Kota Serah Terima']
  work_title text [note: 'Nama Pekerjaan']
  basis_doc_type bast_basis_doc_type [note: 'Jenis Dokumen Dasar']
  basis_doc_number text [note: 'Nomor Dokumen Dasar']
  basis_doc_date_text text [note: 'Tanggal Dokumen Dasar Tertulis']
  basis_doc_date date [note: 'Tanggal Dokumen Dasar']
  basis_doc_value numeric(18,2) [note: 'Nilai Dokumen Dasar; CHECK (basis_doc_value >= 0)']
  basis_doc_value_vat bast_basis_doc_value_vat [note: 'PPN Nilai Dasar']
  currency char(3) [not null, default: 'IDR', note: 'Mata Uang']
  acceptance_statement text [note: 'Pernyataan Penerimaan']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'BAST. DITUNDA: dirancang bersama RPA (nomor & render) dan Network Engineer (lampiran) di workshop skema. BAST hasil ekstraksi dokumen lama atau hasil susunan sistem. Ditulis oleh: USULAN, belum dibuat di NocoDB. Pemilik: AI Engineer'
}

Table bast_party [headercolor: #F1C40F] {
  id bigint [pk, increment]
  bast_id integer [not null, note: 'ID BAST']
  role bast_party_role [not null, note: 'Peran. peran, BUKAN \'Pihak Pertama/Kedua\' -- label itu terbalik antar-format']
  org_name_text text [not null, note: 'Nama Instansi']
  signer_name text [note: 'Nama Penandatangan. kosong bila tidak terbaca']
  signer_title text [note: 'Jabatan Penandatangan']
  org_address_text text [note: 'Alamat']
  mybhakti_party_ref text [note: 'Rujukan Pihak MyBhakti']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (bast_id, role) [unique]
  }

  Note: 'Pihak BAST. DITUNDA: dirancang bersama RPA (nomor & render) dan Network Engineer (lampiran) di workshop skema. Tepat 2 baris per BAST: penyerah dan penerima. Ditulis oleh: USULAN, belum dibuat di NocoDB. Pemilik: AI Engineer'
}

Table bast_item [headercolor: #F1C40F] {
  id bigint [pk, increment]
  bast_id integer [not null, note: 'ID BAST']
  line_no integer [not null, note: 'No Urut; CHECK (line_no > 0)']
  contract_item_id integer [note: 'ID Rincian Kontrak. baris BoQ kontrak yang diserahkan; uraian & harga dibaca dari kontrak']
  description text [not null, note: 'Uraian']
  quantity numeric(18,2) [note: 'Volume. volume yang DISERAHKAN -- bisa lebih kecil dari kontrak bila parsial; CHECK (quantity >= 0)']
  unit text [note: 'Satuan']
  unit_price numeric(18,2) [note: 'Harga Satuan; CHECK (unit_price >= 0)']
  line_total numeric(18,2) [note: 'Jumlah Harga; CHECK (line_total >= 0)']
  test_result text [note: 'Hasil Uji. diisi setelah uji, bukan sebelumnya']
  activation_date_text text [note: 'Tanggal Aktif Tertulis']
  activation_date date [note: 'Tanggal Aktif']
  service_order_ref text [note: 'Nomor AO']
  service_id text [note: 'SID']
  location text [note: 'Lokasi']
  remarks text [note: 'Keterangan']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (bast_id, line_no) [unique]
  }

  Note: 'Rincian BAST. DITUNDA: dirancang bersama RPA (nomor & render) dan Network Engineer (lampiran) di workshop skema. Baris serah terima. Ditulis oleh: USULAN, belum dibuat di NocoDB. Pemilik: AI Engineer'
}

Table bast_condition [headercolor: #F1C40F] {
  id bigint [pk, increment]
  bast_id integer [not null, note: 'ID BAST']
  condition_type bast_condition_condition_type [not null, note: 'Jenis Kondisi']
  value_text text [note: 'Nilai Teks']
  value_number numeric(18,2) [note: 'Nilai Angka']
  value_date date [note: 'Nilai Tanggal']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'Kondisi BAST. DITUNDA: dirancang bersama RPA (nomor & render) dan Network Engineer (lampiran) di workshop skema. Fakta tambahan BAST sebagai baris, bukan kolom baru. Ditulis oleh: USULAN, belum dibuat di NocoDB. Pemilik: AI Engineer'
}

Table bast_draft [headercolor: #F1C40F] {
  id bigint [pk, increment]
  contract_id integer [not null, note: 'ID Kontrak']
  draft_bast_number text [note: 'Nomor Draf']
  work_title text [not null, note: 'Nama Pekerjaan']
  handover_date_text text [note: 'Tanggal Serah Terima Tertulis']
  handover_date date [note: 'Tanggal Serah Terima']
  handover_city text [note: 'Kota Serah Terima']
  status bast_draft_status [not null, note: 'Status']
  template_name text [note: 'Template']
  acceptance_statement text [note: 'Pernyataan Penerimaan']
  generated_doc_url text [note: 'Tautan Dokumen']
  generated_bast_id integer [note: 'ID BAST Tercetak']
  approved_by text [note: '[DIISI PM] Disetujui Oleh']
  approved_at timestamptz [note: '[DIISI PM] Waktu Disetujui']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'Draf BAST. DITUNDA: dirancang bersama RPA (nomor & render) dan Network Engineer (lampiran) di workshop skema. Belum punya kunci anti-dobel: wajib diputuskan sebelum berlaku, karena tanpa kunci, pengiriman ulang menghapus persetujuan PM. Ditulis oleh: USULAN, belum dibuat di NocoDB. Pemilik: RPA Engineer'
}

Table evidence_photo [headercolor: #F1C40F] {
  id bigint [pk, increment]
  odk_instance_id text [not null, unique, note: 'ID Kiriman ODK. sinkron ulang = pembaruan, bukan baris kembar']
  contract_item_id integer [not null, note: 'ID Rincian Kontrak']
  requirement_id integer [note: 'ID Syarat Kontrak']
  component_label text [note: 'Komponen. mis. \'4 Unit Switch\'']
  photo_type evidence_photo_photo_type [not null, note: 'Jenis Foto']
  serial_number text [note: 'Nomor Seri']
  photo_url text [not null, note: 'Tautan Foto']
  taken_at timestamptz [not null, note: 'Waktu Foto']
  gps_lat numeric(9,6) [note: 'Lintang']
  gps_lon numeric(9,6) [note: 'Bujur']
  auto_check_notes text [note: 'Catatan Cek Otomatis']
  review_status evidence_photo_review_status [not null, default: 'pending', note: '[DIISI PM] Status Review']
  reviewed_by text [note: '[DIISI PM] Diperiksa Oleh']
  reviewed_at timestamptz [note: '[DIISI PM] Waktu Diperiksa']
  review_note text [note: '[DIISI PM] Catatan Review']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'Foto Evidence. DITUNDA: usulan untuk disepakati dengan Network Engineer (dol-odk & dol-bast-compiler, hlm. 15). Lampiran wajib kontrak sering berupa DOKUMEN (BA uji terima, surat jalan), bukan foto -- bentuk tabel bukti perlu dibahas bersama. Ditulis oleh: USULAN, belum dibuat di NocoDB. Pemilik: Network Engineer'
}

Table extracted_field [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null, note: 'ID Dokumen']
  field_path text [not null, note: 'Nama Field. mis. \'Nomor Kontrak Kerja\' atau \'List Item/Barang[0].Harga Satuan\'']
  ai_value_text text [note: 'Nilai Terbaca Sistem']
  evidence_page integer [note: 'Halaman Bukti. dihitung sistem, bukan ditulis LLM']
  evidence_quote text [note: 'Kutipan Bukti. potongan teks dokumen tempat nilai ditemukan']
  evidence_score numeric(18,2) [note: 'Skor Bukti. 0-1: seberapa persis nilai ditemukan di teks dokumen']
  system_status extracted_field_system_status [not null, note: 'Status Bukti. saran sistem, BUKAN persetujuan. Yang diperiksa sistem hanya apakah nilai ada di dokumen, bukan apakah perannya benar']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (document_id, field_path) [unique]
  }

  Note: 'Hasil Ekstraksi. Satu baris per field: nilai terbaca + bukti. Antrean kerja PM. Ditulis mesin saja; dokumen yang sudah mulai diperiksa PM tidak ditimpa otomatis. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table field_review [headercolor: #E67E22] {
  id bigint [pk, increment]
  document_id integer [not null, note: 'ID Dokumen. dokumen dengan keputusan PM tidak boleh terhapus diam-diam']
  field_path text [not null, note: 'Nama Field']
  reviewed_ai_value_text text [note: 'Nilai Sistem Saat Diperiksa. nilai yang DILIHAT PM saat memutuskan; bila nilai sistem berubah, keputusan lama tidak berlaku untuk nilai baru']
  decision field_review_decision [not null, note: 'Keputusan']
  final_value_text text [note: 'Nilai Final. wajib diisi bila dikoreksi']
  reviewed_by text [not null, note: 'Diperiksa Oleh']
  reviewed_at timestamptz [not null, note: 'Waktu Diperiksa']
  reviewer_note text [note: 'Catatan PM']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  indexes {
    (document_id, field_path) [unique]
  }

  Note: 'Keputusan PM. Keputusan PM per field (hlm. 11 & 20). Pipeline tidak pernah menulis ke sini. Nilai yang boleh dipakai dokumen hilir hanya yang ada keputusannya di sini. Ditulis oleh: MANUSIA (PM) -- pipeline tidak pernah menulis ke sini. Pemilik: PM'
}

Table extraction_run [headercolor: #7F8C8D] {
  id bigint [pk, increment]
  document_id integer [not null, note: 'ID Dokumen']
  ocr_engine text [note: 'Mesin OCR']
  llm_model text [note: 'Model LLM']
  prompt_version text [note: 'Versi Prompt']
  schema_version text [note: 'Versi Skema']
  llm_call_count integer [note: 'Jumlah Panggilan LLM']
  parse_seconds numeric(18,2) [note: 'Detik Pembacaan']
  extract_seconds numeric(18,2) [note: 'Detik Ekstraksi']
  validation_status text [note: 'Status Validasi']
  started_at timestamptz [note: 'Mulai']
  created_at timestamptz [not null, default: `now()`, note: 'Dibuat. UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'Diperbarui. UTC, diperbarui trigger']

  Note: 'Riwayat Pemrosesan. Jejak tiap pemrosesan -- dasar bukti \'Terukur\' (hlm. 21). Hanya di PostgreSQL. Ditulis oleh: mesin -- hanya PostgreSQL, TIDAK dikirim ke NocoDB. Pemilik: AI Engineer'
}

// ---------------------------------------------------------------- relasi
Ref: contract.document_id - document.id [delete: cascade]
Ref: contract_party.contract_id > contract.id [delete: cascade]
Ref: contract_item.contract_id > contract.id [delete: cascade]
Ref: contract_requirement.contract_id > contract.id [delete: cascade]
Ref: contract_payment_term.contract_id > contract.id [delete: cascade]
Ref: sph.document_id - document.id [delete: cascade]
Ref: sph_item.sph_id > sph.id [delete: cascade]
Ref: bast.document_id - document.id [delete: cascade]
Ref: bast.contract_id > contract.id [delete: restrict]
Ref: bast_party.bast_id > bast.id [delete: cascade]
Ref: bast_item.bast_id > bast.id [delete: cascade]
Ref: bast_item.contract_item_id > contract_item.id [delete: restrict]
Ref: bast_condition.bast_id > bast.id [delete: cascade]
Ref: bast_draft.contract_id > contract.id [delete: cascade]
Ref: bast_draft.generated_bast_id > bast.id [delete: restrict]
Ref: evidence_photo.contract_item_id > contract_item.id [delete: restrict]
Ref: evidence_photo.requirement_id > contract_requirement.id [delete: restrict]
Ref: extracted_field.document_id > document.id [delete: cascade]
Ref: field_review.document_id > document.id [delete: restrict]
Ref: extraction_run.document_id > document.id [delete: cascade]

// ---------------------------------------------------------------- pilihan nilai
Enum document_doc_type {
  kontrak
  sph
  bast
}

Enum contract_contract_type {
  nota_pesanan
  surat_pesanan
  spk
  kontrak_kerja_sama
  pks
  lainnya
}

Enum contract_party_role {
  pemberi_kerja
  pelaksana
}

Enum contract_item_charge_type {
  otc
  mrc
  otc_dan_mrc
}

Enum contract_requirement_requirement_type {
  lampiran_wajib
  syarat_serah_terima
  boleh_parsial
}

Enum sph_item_charge_type {
  otc
  mrc
  otc_dan_mrc
}

Enum bast_direction {
  customer
  vendor
  unknown
}

Enum bast_basis_doc_type {
  contract
  pks
  spk
  order_note
  purchase_order
  other
}

Enum bast_basis_doc_value_vat {
  included
  excluded
  unstated
}

Enum bast_party_role {
  handover
  receiver
}

Enum bast_condition_condition_type {
  progress_percent
  service_active_since
  acceptance_test_ref
  delivery_reconciliation_ref
  supporting_document
  amount_in_words
}

Enum bast_draft_status {
  draft
  pending_review
  approved
  generated
  rejected
}

Enum evidence_photo_photo_type {
  item
  serial_label
  installation
  screenshot
}

Enum evidence_photo_review_status {
  pending
  approved
  rejected
}

Enum extracted_field_system_status {
  bukti_kuat
  bukti_cukup
  perlu_dicek
  tidak_ada_di_dokumen
  bertentangan
  kosong
}

Enum field_review_decision {
  benar
  dikoreksi
  ditolak
}

// ---------------------------------------------------------------- kelompok
TableGroup dokumen {
  document
}

TableGroup kontrak {
  contract
  contract_party
  contract_item
  contract_requirement
  contract_payment_term
}

TableGroup sph {
  sph
  sph_item
}

TableGroup bast {
  bast
  bast_party
  bast_item
  bast_condition
  bast_draft
}

TableGroup evidence {
  evidence_photo
}

TableGroup verifikasi {
  extracted_field
  field_review
}

TableGroup audit {
  extraction_run
}
