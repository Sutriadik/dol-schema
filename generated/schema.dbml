// Open ADE — Delivery Ops Layer: skema companion NocoDB
// Dibangkitkan dari dol_schema/model.py (versi companion-2026.10.1).
// JANGAN diedit tangan: ubah model.py lalu jalankan `python -m dol_schema --emit`.
// Buka di dbdiagram.io (tempel isi berkas ini) atau ekstensi DBML di VS Code.

Project dol_schema {
  database_type: 'PostgreSQL'
  Note: 'Warna header = pemilik tabel: biru = AI Engineer, ungu = Network Engineer, hijau = RPA Engineer, oranye = PM, abu-abu = hanya PostgreSQL (tidak dikirim ke NocoDB). Kolom bertanda [DIISI PM] hanya diubah PM. Kolom *_ref MyBhakti sengaja BUKAN foreign key (briefing hlm. 7).'
}

Table document [headercolor: #3498DB] {
  id bigint [pk, increment]
  content_hash text [not null, unique, note: 'sha1 isi berkas -- kunci idempotensi; proses ulang = UPDATE']
  doc_type document_doc_type [not null]
  source_filename text [not null]
  page_count integer [note: 'CHECK (page_count > 0)']
  markdown text [note: 'markdown utuh; PM membaca tanpa membuka PDF']
  validation_notes text [note: '[2026.10.1] peringatan tingkat dokumen untuk PM, mis. salinan ganda atau jumlah item tidak sama dengan total']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'Supertipe: setiap berkas yang masuk, apa pun jenisnya. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null, unique, note: 'UNIQUE -> 1:1 dengan document']
  mybhakti_project_ref text [note: '[2026.10.1] proyek/deal di MyBhakti, diisi n8n -- kunci pengikat semua dokumen satu proyek; SENGAJA bukan FK (hlm. 7)']
  contract_type contract_contract_type [note: '[2026.10.1] bentuk dokumen dasar: nota pesanan, surat pesanan, SPK, kontrak kerja sama, PKS']
  contract_number text [note: 'nomor kontrak resmi / SPK / PKS']
  contract_number_internal text [note: 'nomor registrasi internal BUT']
  work_title text [not null, note: 'judul pengadaan / lingkup pekerjaan']
  contract_date_text text
  contract_date date
  start_date_text text
  start_date date
  end_date_text text
  end_date date
  duration_text text
  contract_value numeric(18,2) [note: 'CHECK (contract_value >= 0)']
  subtotal_value numeric(18,2) [note: 'CHECK (subtotal_value >= 0)']
  vat_value numeric(18,2) [note: 'CHECK (vat_value >= 0)']
  vat_percentage text
  currency char(3) [not null, default: 'IDR', note: 'default IDR']
  payment_mechanism text
  penalty_terms text
  bast_terms text
  bank_name text
  bank_account_number text
  bank_account_name text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'Kontrak/SPK pelanggan dalam bentuk apa pun -- dibaca sekali, dipakai sepanjang proyek (hlm. 11). Sumber utama penyusunan draf BAST. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_party [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null]
  role contract_party_role [not null, note: 'first_party/client (pemberi kerja) vs second_party/contractor (pelaksana)']
  org_name_text text [not null]
  signer_name text [not null]
  signer_title text
  org_address_text text
  npwp text
  mybhakti_party_ref text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (contract_id, role) [unique]
  }

  Note: 'Pihak penandatangan kontrak -- CUPLIKAN seperti tertulis, bukan data master. Satu orang muncul di banyak baris karena menandatangani banyak dokumen. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_item [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null]
  line_no integer [not null, note: 'CHECK (line_no > 0)']
  category text
  description text [not null]
  specification text
  quantity numeric(18,2) [note: 'CHECK (quantity >= 0)']
  unit text
  period text
  unit_price numeric(18,2) [note: 'selalu diverifikasi PM (hlm. 20); CHECK (unit_price >= 0)']
  line_total numeric(18,2) [note: 'CHECK (line_total >= 0)']
  remarks text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (contract_id, line_no) [unique]
  }

  Note: 'BoQ kontrak = kewajiban ke pelanggan (hlm. 7). SUMBER TUNGGAL rincian pekerjaan: SPH vendor, BAST, dan evidence menunjuk ke sini, tidak menyalin. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table contract_requirement [headercolor: #3498DB] {
  id bigint [pk, increment]
  contract_id integer [not null]
  line_no integer [not null, note: 'CHECK (line_no > 0)']
  requirement_type contract_requirement_requirement_type [not null, note: 'lampiran wajib / syarat serah terima / boleh parsial']
  requirement_text text [not null, note: 'mis. \'Berita Acara Uji Terima\'']
  clause_ref text [note: 'pasal rujukan, mis. \'Pasal 9 ayat 2\'']
  evidence_quote text [note: 'kutipan pendek agar PM tidak perlu membaca ulang kontrak (hlm. 11)']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (contract_id, line_no) [unique]
  }

  Note: '[2026.10.1] Aturan dari kontrak, bukan angka: lampiran wajib, syarat serah terima, boleh parsial (hlm. 11). Baris lampiran wajib adalah separuh CHECKLIST GABUNGAN; separuh lainnya evidence teknis milik Network Engineer (hlm. 15). Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table sph [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null, unique]
  mybhakti_project_ref text [note: '[2026.10.1] proyek yang pengadaannya ditawar; diisi n8n']
  mybhakti_vendor_ref text [note: '[2026.10.1] vendor penerbit di MyBhakti; diisi n8n']
  sph_number text
  sph_date_text text
  sph_date date
  project_name text [note: 'perihal / nama pekerjaan yang ditawarkan']
  client_name text [note: 'instansi yang dituju surat']
  vendor_name text [note: 'penerbit SPH seperti tertulis']
  vendor_npwp text
  subtotal_value numeric(18,2) [note: 'CHECK (subtotal_value >= 0)']
  vat_percentage text [note: 'apa adanya di dokumen; sering berupa frasa']
  vat_value numeric(18,2) [note: 'CHECK (vat_value >= 0)']
  total_price numeric(18,2) [note: 'grand total; CHECK (total_price >= 0)']
  validity_text text [note: 'masa berlaku penawaran, mis. \'30 hari\'']
  payment_mechanism text
  currency char(3) [not null, default: 'IDR', note: 'default IDR']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'SPH vendor (rantai hulu) -- lahir DARI kebutuhan kontrak, bukan dasar kontrak. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table sph_item [headercolor: #3498DB] {
  id bigint [pk, increment]
  sph_id integer [not null]
  line_no integer [not null, note: 'CHECK (line_no > 0)']
  contract_item_id integer [note: '[2026.10.1] item kontrak yang dipenuhi baris ini -- kunci price matching & tabel banding antar-vendor (Bulan 5)']
  category text
  description text [not null]
  specification text
  brand text
  part_number text
  quantity numeric(18,2) [note: 'CHECK (quantity >= 0)']
  unit text
  period text
  unit_price numeric(18,2) [note: 'CHECK (unit_price >= 0)']
  line_total numeric(18,2) [note: 'CHECK (line_total >= 0)']
  remarks text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (sph_id, line_no) [unique]
  }

  Note: 'Baris penawaran vendor. Beberapa vendor menawar item kontrak yang sama -> dibandingkan lewat contract_item_id. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table bast [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null, unique, note: 'UNIQUE -> 1:1 dengan document']
  direction bast_direction [not null, note: 'customer = kita->pelanggan (acuan: kontrak); vendor = vendor->kita (acuan: PO) -- hlm. 10']
  contract_id integer [note: 'hanya untuk direction=customer']
  mybhakti_po_ref text [note: 'rujukan opak ke MyBhakti, diisi n8n -- SENGAJA bukan FK (hlm. 7)']
  bast_number_customer text [note: 'nomor versi pelanggan']
  bast_number_internal text [note: 'nomor versi BUT -- dari numbering service milik RPA (hlm. 20)']
  handover_date_text text [note: 'apa adanya di dokumen']
  handover_date date [note: 'hasil parse; NULL kalau gagal']
  handover_city text
  work_title text [not null]
  basis_doc_type bast_basis_doc_type
  basis_doc_number text [note: 'seperti tercetak']
  basis_doc_date_text text
  basis_doc_date date
  basis_doc_value numeric(18,2) [note: 'CHECK (basis_doc_value >= 0)']
  basis_doc_value_vat bast_basis_doc_value_vat
  currency char(3) [not null, default: 'IDR', note: 'default IDR']
  acceptance_statement text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'BAST (hasil ekstraksi atau hasil generate). Pihak & nilai BAST pelanggan dibaca dari kontrak lewat contract_id. Kolom di sini hanya butir yang selalu/hampir selalu ada. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table bast_party [headercolor: #3498DB] {
  id bigint [pk, increment]
  bast_id integer [not null]
  role bast_party_role [not null, note: 'peran, BUKAN \'Pihak Pertama/Kedua\' -- label itu terbalik antar-format']
  org_name_text text [not null, note: 'nama seperti ditandatangani']
  signer_name text [not null]
  signer_title text
  org_address_text text
  mybhakti_party_ref text [note: 'opak, diisi n8n']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (bast_id, role) [unique]
  }

  Note: 'Tepat 2 baris per BAST. Cuplikan saat penandatanganan -- jabatan berubah, dokumen yang sudah diteken tidak boleh ikut berubah. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table bast_item [headercolor: #3498DB] {
  id bigint [pk, increment]
  bast_id integer [not null]
  line_no integer [not null, note: 'CHECK (line_no > 0)']
  contract_item_id integer [note: '[2026.10.1] baris BoQ kontrak yang diserahkan -- bila terisi, uraian & harga DIBACA dari contract_item, sehingga pasti sama dengan kontrak']
  description text [not null]
  quantity numeric(18,2) [note: 'CHECK (quantity >= 0)']
  unit text
  unit_price numeric(18,2) [note: 'CHECK (unit_price >= 0)']
  line_total numeric(18,2) [note: 'CHECK (line_total >= 0)']
  test_result text
  activation_date_text text [note: '[2026.10.1] \'Tanggal Aktif\' apa adanya']
  activation_date date [note: '[2026.10.1] hasil parse']
  service_order_ref text [note: '[2026.10.1] \'No. AO\' layanan']
  service_id text [note: '[2026.10.1] \'SID\' layanan']
  location text [note: '[2026.10.1] lokasi pemasangan / layanan']
  remarks text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (bast_id, line_no) [unique]
  }

  Note: 'Baris serah terima. Kolom [2026.10.1] adalah informasi yang baru ada di tahap serah terima (tanggal aktif, AO/SID, lokasi). Harga boleh NULL: format kampus/vendor/instansi tidak memuatnya. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table bast_condition [headercolor: #3498DB] {
  id bigint [pk, increment]
  bast_id integer [not null]
  condition_type bast_condition_condition_type [not null]
  value_text text
  value_number numeric(18,2)
  value_date date
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'Fakta tambahan BAST sebagai BARIS. Fakta baru = nilai condition_type baru, bukan kolom baru. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table bast_draft [headercolor: #27AE60] {
  id bigint [pk, increment]
  contract_id integer [not null]
  draft_bast_number text
  work_title text [not null]
  handover_date_text text
  handover_date date
  handover_city text
  status bast_draft_status [not null]
  template_name text [note: 'format_telkom | format_kampus | format_instansi']
  acceptance_statement text
  generated_doc_url text
  generated_bast_id integer [note: 'terisi saat status=generated; tanpa ini, kontrak yang di-generate ulang membuat PM tidak tahu draf mana menghasilkan BAST yang mana']
  approved_by text [note: '[DIISI PM] HANYA diisi manusia (PM)']
  approved_at timestamptz [note: '[DIISI PM] HANYA diisi manusia (PM)']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'Draf BAST pelanggan dari kontrak terverifikasi. Nomor dari numbering service, render oleh dol-render (RPA), lampiran oleh compiler BAST (Network). Ditulis oleh: mesin (pipeline). Pemilik: RPA Engineer'
}

Table evidence_photo [headercolor: #8E44AD] {
  id bigint [pk, increment]
  odk_instance_id text [not null, unique, note: 'ID submission ODK Central -- sinkron ulang = update, bukan baris kembar']
  contract_item_id integer [not null, note: 'baris BoQ kontrak yang dibuktikan foto ini']
  requirement_id integer [note: 'lampiran wajib kontrak yang dipenuhi (bila ada) -- sambungan checklist gabungan']
  component_label text [note: 'mis. \'4 Unit Switch\', \'1 Unit Router\'']
  photo_type evidence_photo_photo_type [not null, note: 'foto barang / label serial number / pemasangan / tangkapan layar']
  serial_number text [note: 'wajib untuk foto label SN; bahan registry aset & garansi (Bulan 6)']
  photo_url text [not null]
  taken_at timestamptz [not null, note: 'waktu pengambilan foto']
  gps_lat numeric(9,6) [note: 'lintang, mis. -7.347824']
  gps_lon numeric(9,6) [note: 'bujur, mis. 108.232318']
  auto_check_notes text [note: 'catatan pemeriksaan otomatis n8n, mis. \'jarak 120 m dari lokasi proyek\'']
  review_status evidence_photo_review_status [not null, default: 'pending', note: '[DIISI PM] pending = belum dicek. HANYA PM yang mengubah']
  reviewed_by text [note: '[DIISI PM] HANYA diisi PM']
  reviewed_at timestamptz [note: '[DIISI PM] HANYA diisi PM']
  review_note text [note: '[DIISI PM] alasan bila ditolak, mis. \'SN tidak terbaca\'']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: '[2026.10.1] USULAN untuk disepakati dengan Network Engineer (wilayah dol-odk & dol-bast-compiler, hlm. 15). Foto masuk lewat n8n dari ODK Central SETELAH lolos pemeriksaan otomatis (GPS ada, dalam radius lokasi, dalam masa kontrak); PM lalu menyetujui/menolak di NocoDB. Lampiran BAST hanya memakai review_status=approved. Ditulis oleh: mesin (pipeline). Pemilik: Network Engineer'
}

Table extracted_field [headercolor: #3498DB] {
  id bigint [pk, increment]
  document_id integer [not null]
  field_path text [not null, note: 'mis. contract.Nomor Kontrak Kerja']
  ai_value_text text
  evidence_page integer [note: 'dihitung deterministik, BUKAN ditulis LLM']
  evidence_quote text [note: 'potongan teks dokumen yang cocok']
  evidence_score numeric(18,2) [note: '0-1: seberapa persis nilai ditemukan di teks dokumen']
  system_status extracted_field_system_status [not null, note: 'saran sistem, BUKAN persetujuan']
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (document_id, field_path) [unique]
  }

  Note: 'Satu baris per field: nilai ekstraksi + skor + bukti. Antrean kerja PM. Ditulis mesin saja; nilai terbaru per field. Ditulis oleh: mesin (pipeline). Pemilik: AI Engineer'
}

Table field_review [headercolor: #E67E22] {
  id bigint [pk, increment]
  document_id integer [not null, note: 'RESTRICT: dokumen dengan keputusan PM tidak boleh terhapus diam-diam']
  field_path text [not null]
  reviewed_ai_value_text text [note: 'nilai AI yang DILIHAT PM saat memutuskan; kalau nilai AI berubah, konfirmasi lama tidak berlaku untuk nilai baru']
  decision field_review_decision [not null]
  final_value_text text
  reviewed_by text [not null]
  reviewed_at timestamptz [not null]
  reviewer_note text
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  indexes {
    (document_id, field_path) [unique]
  }

  Note: 'Keputusan PM per field (hlm. 11 & 20). Pipeline tidak pernah menulis ke sini. Ditulis oleh: MANUSIA (PM) -- pipeline tidak pernah menulis ke sini. Pemilik: PM'
}

Table extraction_run [headercolor: #7F8C8D] {
  id bigint [pk, increment]
  document_id integer [not null]
  ocr_engine text
  llm_model text
  prompt_version text
  schema_version text
  llm_call_count integer
  parse_seconds numeric(18,2)
  extract_seconds numeric(18,2)
  validation_status text
  started_at timestamptz
  created_at timestamptz [not null, default: `now()`, note: 'UTC']
  updated_at timestamptz [not null, default: `now()`, note: 'UTC, diperbarui trigger']

  Note: 'Jejak tiap pemrosesan -- dasar bukti \'Terukur\' (hlm. 21). Hanya di PostgreSQL: NocoDB hanya memuat nilai ekstraksi + confidence, bukan metadata teknis AI. Ditulis oleh: mesin -- hanya PostgreSQL, TIDAK dikirim ke NocoDB. Pemilik: AI Engineer'
}

// ---------------------------------------------------------------- relasi
Ref: contract.document_id - document.id [delete: cascade]
Ref: contract_party.contract_id > contract.id [delete: cascade]
Ref: contract_item.contract_id > contract.id [delete: cascade]
Ref: contract_requirement.contract_id > contract.id [delete: cascade]
Ref: sph.document_id - document.id [delete: cascade]
Ref: sph_item.sph_id > sph.id [delete: cascade]
Ref: sph_item.contract_item_id > contract_item.id [delete: restrict]
Ref: bast.document_id - document.id [delete: cascade]
Ref: bast.contract_id > contract.id [delete: restrict]
Ref: bast_party.bast_id > bast.id [delete: cascade]
Ref: bast_item.bast_id > bast.id [delete: cascade]
Ref: bast_item.contract_item_id > contract_item.id [delete: restrict]
Ref: bast_condition.bast_id > bast.id [delete: cascade]
Ref: bast_draft.contract_id > contract.id [delete: cascade]
Ref: bast_draft.generated_bast_id > bast.id [delete: restrict]
Ref: evidence_photo.contract_item_id > contract_item.id [delete: restrict]
Ref: evidence_photo.requirement_id > contract_requirement.id [delete: restrict]
Ref: extracted_field.document_id > document.id [delete: cascade]
Ref: field_review.document_id > document.id [delete: restrict]
Ref: extraction_run.document_id > document.id [delete: cascade]

// ---------------------------------------------------------------- pilihan nilai
Enum document_doc_type {
  contract
  sph
  bast
}

Enum contract_contract_type {
  nota_pesanan
  surat_pesanan
  spk
  kontrak_kerja_sama
  pks
  other
}

Enum contract_party_role {
  first_party
  second_party
  client
  contractor
}

Enum contract_requirement_requirement_type {
  mandatory_attachment
  handover_condition
  partial_delivery
}

Enum bast_direction {
  customer
  vendor
  unknown
}

Enum bast_basis_doc_type {
  contract
  pks
  spk
  order_note
  purchase_order
  other
}

Enum bast_basis_doc_value_vat {
  included
  excluded
  unstated
}

Enum bast_party_role {
  handover
  receiver
}

Enum bast_condition_condition_type {
  progress_percent
  service_active_since
  acceptance_test_ref
  delivery_reconciliation_ref
  supporting_document
  amount_in_words
}

Enum bast_draft_status {
  draft
  pending_review
  approved
  generated
  rejected
}

Enum evidence_photo_photo_type {
  item
  serial_label
  installation
  screenshot
}

Enum evidence_photo_review_status {
  pending
  approved
  rejected
}

Enum extracted_field_system_status {
  auto_verified
  auto_accepted
  review_required
  unsupported
  conflict
  missing
}

Enum field_review_decision {
  confirmed
  corrected
  rejected
}

// ---------------------------------------------------------------- kelompok
TableGroup dokumen {
  document
}

TableGroup kontrak {
  contract
  contract_party
  contract_item
  contract_requirement
}

TableGroup sph {
  sph
  sph_item
}

TableGroup bast {
  bast
  bast_party
  bast_item
  bast_condition
  bast_draft
}

TableGroup evidence {
  evidence_photo
}

TableGroup verifikasi {
  extracted_field
  field_review
}

TableGroup audit {
  extraction_run
}
