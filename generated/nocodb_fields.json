        {
          "column_name": "content_hash",
          "title": "Sidik Berkas",
          "uidt": "SingleLineText",
          "description": "sha256 isi berkas -- kunci anti-dobel; berkas yang sama diproses ulang memperbarui baris yang sama"
        },
        {
          "column_name": "doc_type",
          "title": "Jenis Dokumen",
          "uidt": "SingleSelect",
          "options": [
            "kontrak",
            "sph",
            "bast"
          ]
        },
        {
          "column_name": "source_filename",
          "title": "Nama Berkas",
          "uidt": "SingleLineText",
          "pv": true
        },
        {
          "column_name": "page_count",
          "title": "Jumlah Halaman",
          "uidt": "Number"
        },
        {
          "column_name": "markdown",
          "title": "Isi Dokumen",
          "uidt": "LongText",
          "description": "teks hasil pembacaan sistem, agar PM bisa membaca tanpa membuka PDF. Bagian yang rusak OCR bisa sudah dipoles mesin: PDF asli tetap acuan"
        },
        {
          "column_name": "validation_notes",
          "title": "Catatan Validasi",
          "uidt": "LongText",
          "description": "peringatan tingkat dokumen, mis. salinan ganda atau jumlah item tidak sama dengan total"
        }
      ]
    },
